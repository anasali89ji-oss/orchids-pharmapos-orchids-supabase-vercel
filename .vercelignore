# Vercel deployment ignore file
# These files will not be uploaded to Vercel

# IDE and editor files
.vscode
.idea
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Git
.git
.gitignore
.gitattributes

# Documentation
README.md
*.md
!IMPORTANT_NOTES.md

# Logging
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage
.nyc_output
test
tests
*.spec.ts
*.spec.tsx
*.test.ts
*.test.tsx
__tests__

# Build artifacts (will be built on Vercel)
.next
out
dist
build

# Dependency directories (will be installed on Vercel)
node_modules

# Misc
.cache
.temp
tmp
*.tmp
.env.local
.env.development
.env.test
